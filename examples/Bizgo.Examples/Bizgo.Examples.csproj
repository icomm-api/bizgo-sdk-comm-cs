<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runnable examples (see examples/README.md). Also executed by the tests with a mock server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Bizgo.Examples</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bizgo.Sdk.Comm\Bizgo.Sdk.Comm.csproj" />
  </ItemGroup>

</Project>
